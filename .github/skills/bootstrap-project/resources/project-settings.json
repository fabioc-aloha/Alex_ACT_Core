{
  "$comment": "Self-dogfooding settings — this repo's own Copilot Chat picks up the plugin's own skills/prompts/instructions/agents from .github/. Broad discovery paths mirror Alex_ACT_Steward so multi-tool (Copilot / Claude / agents.io / Synapse) workspaces work uniformly. Heirs installing Core override in their own workspace as needed.",
  "chat.agentSkillsLocations": {
    ".agents/skills": true,
    ".github/skills": true,
    ".claude/skills": true,
    "~/.agents/skills": true,
    "~/.copilot/skills": true,
    "~/.claude/skills": true,
    ".github/skills/local": true
  },
  "chat.promptFilesLocations": {
    ".github/prompts": true,
    ".github/prompts/local": true
  },
  "chat.agentFilesLocations": {
    ".github/agents": true,
    ".github/agents/local": true
  },
  "chat.instructionsFilesLocations": {
    ".github/instructions": true
  },
  "chat.permissions.default": "autoApprove",
  "editor.formatOnSave": true,
  "editor.guides.bracketPairs": "active",
  "editor.inlineSuggest.enabled": true,
  "editor.linkedEditing": true,
  "editor.minimap.enabled": false,
  "editor.renderWhitespace": "boundary",
  "editor.stickyScroll.enabled": true,
  "diffEditor.hideUnchangedRegions.enabled": true,
  "diffEditor.ignoreTrimWhitespace": false,
  "diffEditor.wordWrap": "on",
  "[markdown]": {
    "editor.wordWrap": "on",
    "editor.quickSuggestions": {
      "other": "on",
      "comments": "off",
      "strings": "off"
    },
    "editor.rulers": []
  },
  "files.autoSave": "onFocusChange",
  "files.encoding": "utf8",
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.trimTrailingWhitespace": true,
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/coverage/**": true,
    "**/.next/**": true
  },
  "search.smartCase": true,
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/build": true,
    "**/coverage": true,
    "**/.next": true
  },
  "terminal.integrated.copyOnSelection": true,
  "terminal.integrated.defaultProfile.windows": "pwsh",
  "terminal.integrated.profiles.windows": {
    "pwsh": {
      "path": "pwsh.exe"
    }
  },
  "terminal.integrated.scrollback": 20000,
  "terminal.integrated.tabs.allowAgentCliTitle": true,
  "git.autofetch": true,
  "git.branchProtection": [
    "main"
  ],
  "git.closeDiffOnOperation": true,
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "git.openRepositoryInParentFolders": "always",
  "git.pruneOnFetch": true,
  "markdown.styles": [
    ".vscode/markdown-light.css"
  ],
  "markdown.updateLinksOnFileMove.enabled": "always",
  "markdown.editor.updateLinksOnPaste.enabled": true
}
