# OS / editor / tooling scratch — the plugin's installable payload is markdown
# and JSON only. `scripts/` (when it exists) holds repo tooling (not shipped);
# no node_modules, dist output, or build artifacts.

# macOS
.DS_Store

# Windows
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# VS Code — TRACKED, not ignored. `.vscode/settings.json` is this repo's source
# of truth for how an adopting workspace is wired up (skill/prompt/agent
# discovery roots). Dogfooding it here means a path regression breaks for us
# before it ships.

# JetBrains
.idea/

# Editor swap files
*.swp
*.swo
*~

# Node (nothing published from this repo — no package.json — but in case
# a contributor scaffolds a local script harness)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local env / secrets — do NOT commit
.env
.env.*
!.env.example

# Local logs / scratch
*.log
.tmp/
tmp/
scratch/

# Local repo tooling that isn't shipped as plugin content
.github/scripts/local/
